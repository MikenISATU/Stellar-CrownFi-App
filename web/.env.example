# --- Supabase Postgres ---  (setup guide: SUPABASE.md in the repo root)
# Get both URLs from Supabase -> Connect -> ORMs -> Prisma. Replace <ref>, <pw>, <region>.
# DATABASE_URL = pooled (port 6543, keep ?pgbouncer=true). DIRECT_URL = direct (port 5432, migrations).
DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# --- Database ---
# For production, set a PostgreSQL/Supabase URL AND change provider in prisma/schema.prisma to "postgresql".

# --- Wallet provider ---
# mock | privy   (mock generates simulated Stellar addresses so the app runs with no keys)
WALLET_PROVIDER="mock"
# NEXT_PUBLIC_PRIVY_APP_ID=""
# PRIVY_APP_SECRET=""
# Required for Freighter Mobile on iPhone/Android (create at dashboard.reown.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# --- Stellar ---
# mock | live   (mock returns simulated tx hashes so anchoring/minting runs offline)
STELLAR_MODE="mock"
STELLAR_NETWORK="testnet"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
# Secret key used by the platform to sign anchor/mint transactions in live mode (server only).
# STELLAR_PLATFORM_SECRET=""
# Deployed contract ids (live mode)
# AUDIT_ANCHOR_CONTRACT_ID=""
# TICKET_CONTRACT_ID=""
# COLLECTIBLE_CONTRACT_ID=""
# SALE_SPLITTER_CONTRACT_ID=""
# USDC settlement for collectible purchases (buyer-signed via Freighter):
# USDC_TEST_CONTRACT_ID=""      # the mintable test-USDC token (contracts/usdc-test)
# DEMO_CONTESTANT_PAYOUT=""     # G... wallet that receives the contestant's cut in demo listings
# After deploying, register listings once:  npx tsx --env-file=.env scripts/register-listings.ts

# --- Voting ---
# Simple per-account vote quota per round.
VOTE_QUOTA_PER_ROUND="1"

# --- Rate limiting ---
# memory | upstash  (memory works out of the box; upstash for production)
RATELIMIT_MODE="memory"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Freighter / client Stellar network (Testnet for now) ---
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Admin wallets (comma-separated Stellar G... addresses) ---
# Prefer ADMIN_WALLETS on the server. Keep NEXT_PUBLIC_ADMIN_WALLETS only for client UI hints.
ADMIN_WALLETS=""
NEXT_PUBLIC_ADMIN_WALLETS=""
# Required in production for httpOnly admin session cookies. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""
# Optional, used in wallet-signature challenge text. Example: https://crownfi.example
NEXT_PUBLIC_APP_ORIGIN=""
# --- New Soroban contracts (finale build: prediction markets + pageant NFTs) ---
# Deploy with contracts/DeploySC.md, then paste the printed ids.
PAGEANT_NFT_CONTRACT_ID=""
PREDICTION_MARKET_CONTRACT_ID=""
# V2 enables admin-assisted refunds during force deletion. Existing V1 rows continue
# using PREDICTION_MARKET_CONTRACT_ID; new markets record their V2 contract automatically.
PREDICTION_MARKET_CONTRACT_ID_V2="CATV2RPFRMSVMBEJSXQ4SREUOHZ45WJ2F657IQMVYH3CFKB5XZPBVVX7"
# G... address that receives the 2% fee on prediction winnings.
PREDICTION_MARKET_TREASURY=""

# --- Privy (email/Google Web2 login; optional — Freighter works without it) ---
# NEXT_PUBLIC_PRIVY_APP_ID is defined above; the server adapter needs the same id + a secret.
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# --- Email notifications (Resend — optional; unset = emails are skipped) ---
RESEND_API_KEY=""
EMAIL_FROM="CrownFi <onboarding@resend.dev>"

# --- Anti-abuse ---
MAX_ACCOUNTS_PER_IP="20"

# --- Payment / KYC providers (all optional; features stay disabled until keys are set) ---
# TRANSAK_API_KEY=""
# ALCHEMYPAY_APP_ID=""
# ALCHEMYPAY_SECRET=""
# KYC_PROVIDER_API_KEY=""
# KYC_WEBHOOK_SECRET=""

# --- GCash via PayMongo (optional; leave blank to keep GCash checkout disabled) ---
# PAYMONGO_SECRET_KEY=""
# PAYMONGO_PUBLIC_KEY=""
# PAYMONGO_WEBHOOK_SECRET=""
# PHP_PER_USD="58"
